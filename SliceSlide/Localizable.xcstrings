    "Dönen kristal: şekil ilk kesime kadar yavaşça döner. Zamanlamanı yakala ve çizgini doğru anda çek.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spinning crystal: the shape slowly rotates until the first cut. Catch the timing and draw your line at the right moment."
          }
        }
      }
    },
