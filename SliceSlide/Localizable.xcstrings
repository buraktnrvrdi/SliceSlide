    "Beş sezonu da bitirdin. Tüm kristaller koleksiyonunda; istediğini seçip bölümleri yeniden oynayabilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've finished all five seasons. Every crystal is in your collection; pick any and replay the levels."
          }
        }
      }
    },
    "Bu durumdan ipucu çıkarılamadı. Bölümü yeniden başlatmayı dene.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't find a hint from here. Try restarting the level."
          }
        }
      }
    },
    "Bu sefer olmadı. Sandığın aynı kaldı.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No luck this time. Your chest stays the same."
