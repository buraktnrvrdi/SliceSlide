    "Ekranın herhangi bir yerinden parmağını düz bir çizgide sürükle. Şekil çizgi boyunca ikiye ayrılır.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag your finger in a straight line anywhere on the screen. The shape splits in two along the line."
          }
        }
      }
    },
